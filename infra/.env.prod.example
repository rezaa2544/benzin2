# Copy to infra/.env.prod and fill it in. Never commit the filled file.
#
#   cp infra/.env.prod.example infra/.env.prod
#   chmod 600 infra/.env.prod
#
# The compose file has no defaults for the secrets: `docker compose config` fails loudly when one
# is missing, which is exactly what should happen on a clean server at 2 a.m.

# --- identity -------------------------------------------------------------------------------
# Bare domain that Caddy obtains a certificate for and serves.
PUBLIC_HOST=benzin.example.com
# Where the browser reaches the site (used for CORS and the payment callback).
PUBLIC_ORIGIN=https://benzin.example.com
ACME_EMAIL=owner@example.com

# --- secrets (generate with: openssl rand -base64 48) ---------------------------------------
POSTGRES_PASSWORD=change-me-postgres-password
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
OTP_PEPPER=change-me-otp-pepper

# --- database -------------------------------------------------------------------------------
POSTGRES_USER=benzin
POSTGRES_DB=benzin

# --- payments (optional until the merchant id arrives; the card-to-card review path works) ---
ZARINPAL_MERCHANT_ID=

# --- backups --------------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
# Any rclone remote, e.g. `b2:benzin-backups` or `gdrive:benzin`. Empty = local copies only.
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG_FILE=./rclone.conf

# --- node role (G-28) -----------------------------------------------------------------------
NODE_ROLE=primary
NODE_ID=primary-1
LOG_LEVEL=info
