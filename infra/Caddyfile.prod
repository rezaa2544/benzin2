# Production edge for one domain (task G-18).
#
# One origin serves everything: the SPA at `/`, the panel under `/admin/`, the API under `/v1/*`
# and the uptime monitor under `/status/`. One certificate, one CORS story, one thing to back up.
#
# Required environment (docker compose passes it in):
#   PUBLIC_HOST — the bare domain, e.g. benzin.example.com
#   ACME_EMAIL  — Let's Encrypt contact address
#
# Certificate: Caddy asks Let's Encrypt over HTTP-01/TLS-ALPN automatically. For a rehearsal
# without a public domain, run with `TLS_MODE=internal` and Caddy mints a local CA certificate
# instead — the same config path, so the drill exercises the real proxy.
{
	email {$ACME_EMAIL}
	# `TLS_MODE=internal` is the offline drill (self-signed local CA); production leaves it unset
	# and Caddy talks to Let's Encrypt.
	{$TLS_MODE:}
	servers {
		protocols h1 h2 h3
		trusted_proxies static private_ranges
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}

	# The API is same-origin, so the browser never needs CORS in production.
	@api path /v1/* /healthz /ws
	handle @api {
		reverse_proxy api:3000
	}

	# Uptime Kuma has no working base-path support in the image we deploy (server.js never reads
	# UPTIME_KUMA_BASE_PATH), so it gets its own name instead of a broken sub-path. The short URL
	# from the runbook still works: it redirects here.
	# `/status/` → the monitor's own name, keeping the tail: /status/dashboard → status.<host>/dashboard.
	@status path_regexp status ^/status(.*)$
	handle @status {
		redir https://status.{$PUBLIC_HOST}{re.status.1} permanent
	}

	handle /admin/* {
		uri strip_prefix /admin
		reverse_proxy admin:4173
	}

	# Customer PWA, long-cache the hashed assets and never cache the shell.
	handle {
		reverse_proxy web:4173
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}

# The monitor, on its own name (one extra A record: `status` → the same IP).
status.{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy uptime-kuma:3001

	log {
		output file /data/status-access.log {
			roll_size 10mb
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
}
