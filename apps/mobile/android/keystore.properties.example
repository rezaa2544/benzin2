# G-16 — release signing. Copy to `apps/mobile/android/keystore.properties` and fill it in.
# The file is git-ignored on purpose: losing the keystore means a new app on the Play Store.
#
# Generate it once (JDK needed), and keep a backup of the .jks somewhere safe:
#   keytool -genkeypair -v -keystore benzin-release.jks -alias benzin \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS
#
# The path is relative to apps/mobile/android/.
storeFile=../benzin-release.jks
storePassword=change-me
keyAlias=benzin
keyPassword=change-me
